# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# servidor de PO token, baixado e compilado na primeira execucao
/vendor/

# videos baixados e arquivos temporarios do processamento
/videos baixados/
/.tmp-downloads/

# prints locais / rascunhos (nao versionar)
/prints-baixador-linkedin/
*.local.png
scripts/_shot.mjs

